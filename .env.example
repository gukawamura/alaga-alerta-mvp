# Copie para .env e preencha. NUNCA faça commit do .env.
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=troque-por-uma-chave-forte

# Caminho do banco SQLite (no Docker fica no volume /data)
DB_PATH=/data/alaga.db

# Na operação normal, consultar Open-Meteo e o feed IDAP da Defesa Civil.
FONTES_PUBLICAS=1
# Ative ambos apenas para demonstração em um banco separado.
DADOS_DEMO=0
SEED_AUTOMATICO=0
# Mostrar cenários de bueiros baseados na previsão quando não houver sensor recente.
SIMULAR_BUEIROS=1

# Serviços das outras disciplinas (deixe vazio enquanto não estiverem no ar)
ASSISTENTE_URL=
VISAO_URL=
TIMEOUT_SERVICOS=20
LIMIAR_CONFIANCA=0.60

# Só preencha se outro site precisar chamar a API pelo navegador
CORS_ORIGINS=
